---
import type { Locale } from '../lib/i18n';
import { LOCALE_META, LOCALES } from '../lib/i18n';
import { absoluteUrl, hreflangMap, type PageKey } from '../lib/routes';
import { SITE } from '../lib/site';
import { pageDescriptions, pageTitles } from '../lib/ui';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SchemaOrg from '../components/SchemaOrg.astro';
import type { Faq } from '../lib/schema';

interface Props {
  locale: Locale;
  /** Omit for pages outside PAGE_PATHS (then `title`, `description` and `alternates` are required). */
  pageKey?: PageKey;
  title?: string;
  description?: string;
  /**
   * Paths of the translations that really exist, e.g. `{ en: '/en/foo/' }` for a single-language page.
   * Defaults to all three locales of `pageKey`.
   */
  alternates?: Partial<Record<Locale, string>>;
  /** Override the header language switcher targets. */
  langLinks?: Partial<Record<Locale, string>>;
  /** Visible FAQs on the page, emitted as FAQPage JSON-LD. */
  faqs?: Faq[];
  hasReviews?: boolean;
  breadcrumbs?: { name: string; url: string }[];
  ogImage?: string;
  noindex?: boolean;
  bodyClass?: string;
}

const {
  locale,
  pageKey,
  title: titleProp,
  description: descriptionProp,
  alternates: alternatesProp,
  langLinks,
  faqs,
  hasReviews,
  breadcrumbs,
  ogImage = '/og-default.webp',
  noindex = false,
  bodyClass = '',
} = Astro.props;

const titleBase = titleProp ?? (pageKey ? pageTitles[pageKey][locale] : SITE.brand);
/** Home titles in meta.json are complete (brand included); keep them ≤ 60 characters. */
const fullTitle = pageKey === 'home' ? titleBase : `${titleBase} | ${SITE.brand}`;
const description = descriptionProp ?? (pageKey ? pageDescriptions[pageKey][locale] : '');
const canonical = new URL(Astro.url.pathname, Astro.site ?? SITE.url).href;
const alternates: Partial<Record<Locale, string>> = alternatesProp
  ? Object.fromEntries(
      Object.entries(alternatesProp).map(([l, path]) => [l, absoluteUrl(path)]),
    )
  : pageKey
    ? hreflangMap(pageKey)
    : { [locale]: canonical };
const alternateLocales = LOCALES.filter((l) => alternates[l]);
const xDefault = alternateLocales.length > 1 ? alternates.de : canonical;
const schemaPageType =
  pageKey === 'home'
    ? undefined
    : pageKey === 'about'
      ? 'AboutPage'
      : pageKey === 'contact'
        ? 'ContactPage'
        : 'WebPage';
const ogLocale = LOCALE_META[locale].ogLocale;
const htmlLang = LOCALE_META[locale].htmlLang;
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {/* Remember last language (localStorage only — no cookies). Redirect home entry points. */}
    <script is:inline>
      (function () {
        try {
          var preferred = localStorage.getItem('jaf_lang');
          if (preferred !== 'de' && preferred !== 'en' && preferred !== 'es') return;

          var path = location.pathname;
          if (path !== '/' && path !== '/en/' && path !== '/es/') return;

          var current = path.indexOf('/en/') === 0 ? 'en' : path.indexOf('/es/') === 0 ? 'es' : 'de';
          if (preferred === current) return;

          var homes = { de: '/', en: '/en/', es: '/es/' };
          location.replace(homes[preferred] + location.search + location.hash);
        } catch (e) {}
      })();
    </script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.brand} />
    {noindex ? (
      <meta name="robots" content="noindex, follow" />
    ) : (
      <meta name="robots" content="index, follow" />
    )}
    <link rel="canonical" href={canonical} />
    {
      alternateLocales.map((l) => (
        <link rel="alternate" hreflang={LOCALE_META[l].htmlLang} href={alternates[l]} />
      ))
    }
    {xDefault && <link rel="alternate" hreflang="x-default" href={xDefault} />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.brand} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale} />
    {
      alternateLocales.filter((l) => l !== locale).map((l) => (
        <meta property="og:locale:alternate" content={LOCALE_META[l].ogLocale} />
      ))
    }
    <meta property="og:image" content={absoluteUrl(ogImage)} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteUrl(ogImage)} />

    <meta name="ahrefs-site-verification" content={SITE.ahrefsSiteVerification} />
    <meta name="facebook-domain-verification" content={SITE.facebookDomainVerification} />

    <link rel="icon" href="/favicons/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicons/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/favicons/apple-touch-icon.png" />
    <link rel="manifest" href="/favicons/site.webmanifest" />

    <link
      rel="preload"
      href="/fonts/roboto-mono/roboto-mono-300.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/roboto-mono/roboto-mono-400.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <SchemaOrg
      lang={locale}
      pageType={schemaPageType}
      pageName={fullTitle}
      breadcrumbs={breadcrumbs}
      faqs={faqs}
      hasReviews={hasReviews}
    />
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <div class="site-shell">
      <Header locale={locale} pageKey={pageKey} langLinks={langLinks} />
      <main class="site-main" id="main">
        <slot />
      </main>
      <Footer locale={locale} />
    </div>
    <script is:inline>
      (function () {
        try {
          var path = location.pathname;
          var m = path.match(/^\/(en|es)(\/|$)/);
          var lang = m ? m[1] : 'de';
          localStorage.setItem('jaf_lang', lang);
        } catch (e) {}
      })();
    </script>
  </body>
</html>
