---
import type { OptimizedSlide } from '../lib/images';
import {
  DEFAULT_MASONRY_BREAKPOINTS,
  DEFAULT_MASONRY_GAP_PX,
  type MasonryBreakpoint,
} from '../lib/masonry/index.ts';
import type { Locale } from '../lib/i18n';
import { ui } from '../lib/ui';

interface Props {
  /** Pre-optimized slides (from `optimizeGalleryImages` / project resolver). */
  slides: OptimizedSlide[];
  /** Uniform gap between items (px). Also exposed as `--masonry-gap`. */
  gap?: number;
  /** Column breakpoints keyed by minimum container width. */
  breakpoints?: MasonryBreakpoint[];
  /** Optional max content width inside the gallery element. */
  maxWidth?: number;
  /** First N images use loading="eager" (+ fetchpriority on the first). */
  eagerCount?: number;
  /** Show figcaptions when captionHtml is set. */
  showCaptions?: boolean;
  /** Locale for lightbox chrome (required when enableLightbox is true). */
  locale?: Locale;
  /** Wire the existing project lightbox behavior. */
  enableLightbox?: boolean;
  /** Accessible name for the gallery region. */
  ariaLabel?: string;
  /** Extra class on the root element. */
  class?: string;
}

const {
  slides,
  gap = DEFAULT_MASONRY_GAP_PX,
  breakpoints = DEFAULT_MASONRY_BREAKPOINTS,
  maxWidth,
  eagerCount = 2,
  showCaptions = true,
  locale,
  enableLightbox = false,
  ariaLabel,
  class: className,
} = Astro.props;

const breakpointsJson = JSON.stringify(breakpoints);

const lightboxPayload =
  enableLightbox && locale
    ? JSON.stringify({
        slides: slides.map((s) => ({
          src: s.fullSrc,
          alt: s.alt,
          captionHtml: s.captionHtml,
          width: s.width,
          height: s.height,
        })),
        labels: {
          close: ui.gallery.close[locale],
          prev: ui.gallery.prev[locale],
          next: ui.gallery.next[locale],
          of: ui.gallery.of[locale],
        },
      })
    : null;

/** sizes aligned with column breakpoints (approx vw per column). */
const sizes =
  '(max-width: 479px) 100vw, (max-width: 767px) 50vw, (max-width: 1023px) 33vw, 25vw';
---

{
  slides.length > 0 && (
    <div
      class:list={['masonry-gallery', className]}
      data-masonry-gallery
      data-gap={gap}
      data-breakpoints={breakpointsJson}
      {...(typeof maxWidth === 'number' ? { 'data-max-width': maxWidth } : {})}
      {...(enableLightbox ? { 'data-gallery': true } : {})}
      style={`--masonry-gap: ${gap}px;${typeof maxWidth === 'number' ? ` max-width: ${maxWidth}px;` : ''}`}
      role="region"
      aria-label={ariaLabel}
    >
      {lightboxPayload && (
        <script type="application/json" data-lightbox-json set:html={lightboxPayload} />
      )}
      {slides.map((slide, index) => {
        const hasCaption = Boolean(showCaptions && slide.captionHtml);
        return (
          <figure
            class="masonry-gallery__item"
            data-masonry-item
            data-id={slide.filename}
            data-width={slide.width}
            data-height={slide.height}
            data-has-caption={hasCaption ? '1' : '0'}
          >
            {enableLightbox && locale ? (
              <button
                type="button"
                class="masonry-gallery__trigger"
                data-index={index}
                aria-label={`${ui.gallery.open[locale]}: ${slide.alt || index + 1}`}
              >
                <img
                  src={slide.thumbSrc}
                  srcset={slide.srcset}
                  sizes={sizes}
                  width={slide.width}
                  height={slide.height}
                  alt={slide.alt}
                  loading={index < eagerCount ? 'eager' : 'lazy'}
                  decoding="async"
                  {...(index === 0 ? { fetchpriority: 'high' } : {})}
                />
              </button>
            ) : (
              <div class="masonry-gallery__frame">
                <img
                  src={slide.thumbSrc}
                  srcset={slide.srcset}
                  sizes={sizes}
                  width={slide.width}
                  height={slide.height}
                  alt={slide.alt}
                  loading={index < eagerCount ? 'eager' : 'lazy'}
                  decoding="async"
                  {...(index === 0 ? { fetchpriority: 'high' } : {})}
                />
              </div>
            )}
            {hasCaption && (
              <figcaption class="masonry-gallery__caption" set:html={slide.captionHtml} />
            )}
          </figure>
        );
      })}
    </div>
  )
}

<style>
  .masonry-gallery {
    --masonry-gap: 12px;
    position: relative;
    width: 100%;
    max-width: 100%;
    margin-inline: auto;
    background: var(--color-bg, #f4f4f2);
    /* No-JS / pre-pack: single column stack preserves aspect ratios and DOM order. */
    display: flex;
    flex-direction: column;
    gap: var(--masonry-gap);
  }

  .masonry-gallery[data-packed='1'] {
    display: block;
    gap: 0;
  }

  .masonry-gallery__item {
    margin: 0;
    width: 100%;
  }

  .masonry-gallery[data-packed='1'] .masonry-gallery__item {
    /* width/left/top set by the packer */
    margin: 0;
  }

  .masonry-gallery__trigger,
  .masonry-gallery__frame {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    box-shadow: none;
    overflow: hidden;
  }

  .masonry-gallery__trigger {
    cursor: zoom-in;
  }

  .masonry-gallery__trigger img,
  .masonry-gallery__frame img {
    display: block;
    width: 100%;
    height: auto;
    vertical-align: middle;
    border: 0;
    border-radius: 0;
    box-shadow: none;
  }

  .masonry-gallery__caption {
    margin-top: 0.4rem;
    font-size: var(--text-xs, 0.75rem);
    letter-spacing: var(--tracking-wide, 0.04em);
    text-transform: uppercase;
    color: var(--color-ink-muted, #666);
  }

  .masonry-gallery__caption :global(a) {
    color: inherit;
    text-underline-offset: 0.15em;
  }

</style>

<script>
  import '../scripts/masonry-gallery';
</script>

{
  enableLightbox && (
    <>
      <script>
        import '../scripts/gallery-lightbox';
      </script>
      <style is:global>
        .lb {
          position: fixed;
          inset: 0;
          z-index: 1000;
          display: flex;
          flex-direction: column;
          align-items: center;
          background: rgba(10, 10, 10, 0.94);
          color: #f4f4f2;
        }
        .lb__caption {
          position: relative;
          z-index: 1;
          flex: 0 0 3.25rem;
          display: flex;
          align-items: center;
          justify-content: center;
          width: min(40rem, calc(100% - 2rem));
          margin: 0;
          padding: 0 1rem;
          text-align: center;
          font-size: 0.75rem;
          letter-spacing: 0.08em;
          text-transform: uppercase;
          line-height: 1.3;
        }
        .lb__caption a {
          color: inherit;
          text-underline-offset: 0.15em;
        }
        .lb__backdrop {
          position: absolute;
          inset: 0;
          border: 0;
          background: transparent;
          cursor: zoom-out;
        }
        .lb__frame {
          position: relative;
          z-index: 1;
          flex: 1 1 auto;
          width: min(92vw, 1100px);
          min-height: 0;
          margin-top: 3.5rem;
          display: flex;
          align-items: center;
          justify-content: center;
        }
        .lb__frame img {
          width: 100%;
          height: 100%;
          object-fit: contain;
          object-position: center;
        }
        .lb__toolbar {
          position: absolute;
          top: 1rem;
          right: 1rem;
          z-index: 2;
          display: flex;
          align-items: center;
          gap: 1rem;
          font-size: var(--text-sm);
          letter-spacing: var(--tracking-wide);
        }
        .lb__btn,
        .lb__nav {
          border: 1px solid rgba(244, 244, 242, 0.35);
          background: transparent;
          color: inherit;
          font: inherit;
          cursor: pointer;
          padding: 0.45rem 0.8rem;
        }
        .lb__nav {
          position: absolute;
          top: 50%;
          transform: translateY(-50%);
          z-index: 2;
          font-size: var(--text-2xl);
          line-height: 1;
          padding: 0.35rem 0.7rem;
        }
        .lb__nav--prev {
          left: 0.75rem;
        }
        .lb__nav--next {
          right: 0.75rem;
        }
        @media (max-width: 600px) {
          .lb__nav {
            display: none;
          }
        }
      </style>
    </>
  )
}
