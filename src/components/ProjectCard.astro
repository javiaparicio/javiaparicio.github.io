---
import type { Locale } from '../lib/i18n';
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { ui } from '../lib/ui';

interface Props {
  locale: Locale;
  href: string;
  title: string;
  description?: string;
  categoryLabel: string;
  cover?: ImageMetadata;
  coverAlt?: string;
}

const { locale, href, title, description, categoryLabel, cover, coverAlt = '' } =
  Astro.props;
---

<a class="project-card" href={href}>
  <div class="project-card__media">
    {
      cover ? (
        <Image
          src={cover}
          alt={coverAlt || title}
          widths={[480, 800, 1200]}
          sizes="(max-width: 700px) 100vw, 50vw"
          format="webp"
          quality={82}
          loading="lazy"
        />
      ) : (
        <div class="project-card__placeholder" aria-hidden="true" />
      )
    }
  </div>
  <div class="project-card__meta">
    <p class="project-card__cat">{categoryLabel}</p>
    <h3 class="project-card__title">{title}</h3>
    {description && <p class="project-card__desc">{description}</p>}
    <span class="project-card__cta">{ui.portfolio.view[locale]}</span>
  </div>
</a>

<style>
  .project-card {
    display: grid;
    gap: 1rem;
    text-decoration: none;
    color: inherit;
  }
  .project-card:hover {
    opacity: 1;
  }
  .project-card__media {
    overflow: hidden;
    background: #e6e6e2;
    aspect-ratio: 4 / 5;
  }
  .project-card__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--img-focus-face);
    transform-origin: var(--img-focus-face);
    transition: transform 0.7s var(--ease);
  }
  @media (hover: hover) {
    .project-card:hover .project-card__media :global(img) {
      transform: scale(1.03);
    }
  }
  .project-card__placeholder {
    width: 100%;
    height: 100%;
    background: #ddd;
  }
  .project-card__cat {
    margin: 0 0 var(--space-2);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }
  .project-card__title {
    margin: 0 0 var(--gap-heading);
    font-size: var(--text-xl);
    font-weight: 400;
    letter-spacing: var(--tracking-snug);
    line-height: 1.3;
  }
  .project-card__desc {
    margin: 0;
    color: var(--color-ink-muted);
    font-size: var(--text-base);
    line-height: 1.55;
  }
  .project-card__cta {
    display: inline-block;
    margin-top: var(--gap-heading);
    font-size: var(--text-sm);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
</style>
